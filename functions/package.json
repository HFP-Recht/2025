{
  "name": "@hfp/functions",
  "private": true,
  "version": "0.1.0",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude tests/firestore.rules.test.ts --passWithNoTests",
    "test:rules": "vitest run tests/firestore.rules.test.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth,storage"
  },
  "dependencies": {
    "@hfp/prompt-engine": "0.1.0",
    "firebase-admin": "^13.1.0",
    "firebase-functions": "^6.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
